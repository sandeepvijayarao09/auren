# Copy to .env (never commit the real one). Only MODEL_API_KEY is needed to start.

# Meta Model API key from dev.meta.ai
MODEL_API_KEY=
# Models (defaults shown)
AUREN_AGENT_MODEL=muse-wonder-1.0
AUREN_FAST_MODEL=muse-spark-1.3

# Lets your phone, watch and the Mac driver reach Core over the network.
# Without it, Core listens on 127.0.0.1 only.
AUREN_TOKEN=
# TLS for the LAN: run `make cert`, then point these at the PEM files (paths relative to core/).
AUREN_TLS_CERT=
AUREN_TLS_KEY=

# Computer use (driver/): the sites the browser may open, comma-separated. Subdomains count.
AUREN_DRIVER_ALLOW=
# Where the driver finds Core, if not http://127.0.0.1:8787
AUREN_CORE_URL=

# Google Calendar now, Gmail on Day 2: a "Desktop app" OAuth client (docs/google-setup.md).
# Demo account only, never real student data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack demo workspace bot token (docs/slack-setup.md)
SLACK_BOT_TOKEN=

# Optional: encrypts connector tokens (openssl rand -hex 32). Without it, Core keeps a key in auren.db.key.
AUREN_SECRET=
# Optional: your time zone, if this Mac's is wrong (e.g. America/Los_Angeles)
AUREN_TZ=
# Follow-ups: a command within this many seconds of the last one also gets a short note of it,
# so "Actually, move it to 4 instead" knows what "it" is (0 = off)
AUREN_FOLLOWUP_WINDOW_S=300

# Day 7: Auren Memory on Muse Spark Open (Baseten)
BASETEN_API_KEY=

# R11: MCP servers to connect (docs/mcp-setup.md). Empty means mcp.json at the repo root.
AUREN_MCP_CONFIG=

# R9: Auren Router, the Glimmer LoRA served on Modal (router/README.md). Without the URL,
# Muse Spark routes when MODEL_API_KEY is set, else simple rules. Advisory only.
AUREN_ROUTER_URL=
AUREN_ROUTER_KEY=
AUREN_ROUTER_MODEL=auren-router
# How long Core waits for the router before Wonder starts, in ms
AUREN_ROUTER_BUDGET_MS=300

# Spend limits, in model tokens (Muse prices aren't published, so Auren counts tokens, not money).
# The alarm logs one warning and shows a banner in the console; the limit refuses new commands
# (approvals already waiting still go through). Empty or 0 turns either off. Usage is in /v1/trust.
AUREN_TOKEN_ALARM=
AUREN_TOKEN_LIMIT=

# The public sandbox (`make sandbox`): /try on a fictional demo world, for judges. It never opens
# auren.db, the master key, connectors, devices, the camera or the driver, whatever else is set here.
# Without MODEL_API_KEY, or once the budget is spent, the golden paths replay from eval/scripts.
AUREN_SANDBOX=false
# Tokens the live engine may spend across every visitor before it switches to replay (0 = replay only)
AUREN_SANDBOX_TOKEN_BUDGET=200000
# Commands per visitor address, per minute and per UTC day
AUREN_SANDBOX_RPM=6
AUREN_SANDBOX_DAILY=60
# Visitors at once (each gets its own demo world, which expires after 30 minutes idle)
AUREN_SANDBOX_MAX_VISITORS=50
# Behind a tunnel or proxy: trust X-Forwarded-For through this many hops ("true" means 1).
# Leave empty when nothing is in front, or every visitor's address can be forged.
AUREN_TRUST_PROXY=
