{
  "case": "multi-turn-move-it-again",
  "note": "The follow-up starts with Core's note of the last command (agent/followup.ts). It reads the event id from that note ({{context:event_id}}), so the case fails if the note isn't carried over.",
  "commands": [
    {
      "ack": "On it: calendar.",
      "turns": [
        {
          "calls": [
            {
              "tool": "calendar.list_events",
              "args": {
                "date": "{{today}}"
              }
            }
          ]
        },
        {
          "calls": [
            {
              "tool": "calendar.move_event",
              "args": {
                "event_id": "evt_1",
                "new_start": "{{today}}T15:30"
              }
            }
          ]
        },
        {
          "ms": 200,
          "say": "Office hours now start at 3:30."
        }
      ]
    },
    {
      "ack": "On it: calendar.",
      "turns": [
        {
          "calls": [
            {
              "tool": "calendar.move_event",
              "args": {
                "event_id": "{{context:event_id}}",
                "new_start": "{{today}}T16:00"
              }
            }
          ]
        },
        {
          "ms": 200,
          "say": "Moved office hours to 4 instead."
        }
      ]
    }
  ]
}
