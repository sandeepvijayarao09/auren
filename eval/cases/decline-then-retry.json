{
  "id": "decline-then-retry",
  "title": "The person declines a post, then asks again with new text: only the second one posts",
  "golden_path": null,
  "category": "tier-gate",
  "surface": "web",
  "online": [
    "web",
    "watch"
  ],
  "commands": [
