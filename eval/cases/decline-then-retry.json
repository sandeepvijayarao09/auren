    "Okay, post 'Demo moved to 7:30, pizza at 7' instead."
  ],
  "fixtures": {
    "expect_post": {
      "channel": "general",
      "text": "7:30"
    }
  },
  "script": [],
  "expect": {
    "tools": [
      "slack.post_message"
    ],
