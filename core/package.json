{
  "name": "auren-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auren Core: one Muse agent, one live session, every surface.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "eval": "node --env-file-if-exists=../.env src/eval/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "^4.13.14",
    "jpeg-js": "^0.4.4",
    "openai": "^7.44.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^7.0.2"
  }
}
