{
  "name": "auren-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auren's computer-use driver: runs Muse Wonder's computer actions in a headed browser on your Mac, and stops before any commit.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "playwright": "1.64.1",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
